@@ -0,0 +1,26 @@
+import { describe, expect, test } from "bun:test"
+import { checkForkHubOwner, normalizeForkHubOwner } from "./forkhub"
+
+describe("normalizeForkHubOwner", () => {
+  test("accepts valid names", () => {
+    expect(normalizeForkHubOwner("ImBIOS")).toBe("ImBIOS")
+  })
+  test("rejects invalid names", () => {
+    expect(normalizeForkHubOwner("not a name!")).toBeNull()
+    expect(normalizeForkHubOwner("")).toBeNull()
+  })
+})
+
+describe("checkForkHubOwner", () => {
+  test("passes when releases exist", async () => {
+    const fetchImpl = (async () =>
+      new Response(JSON.stringify([{ tag_name: "v2.0.16", draft: false }]), { status: 200 })) as unknown as typeof fetch
+    const result = await checkForkHubOwner("ImBIOS", fetchImpl)
+    expect(result.owner).toBe("ImBIOS")
+    expect(result.latestTag).toBe("v2.0.16")
+  })
+  test("fails on 404", async () => {
+    const fetchImpl = (async () => new Response("nope", { status: 404 })) as unknown as typeof fetch
+    await expect(checkForkHubOwner("ImBIOS", fetchImpl)).rejects.toThrow("no .forkhub releases")
+  })
+})
diff --git a/packages/app/src/shell/updates/forkhub.ts b/packages/app/src/shell/updates/forkhub.ts
new file mode 100644
index 0000000000..94bb86ac66
--- /dev/null
+++ b/packages/app/src/shell/updates/forkhub.ts
@@ -0,0 +1,49 @@
+// ForkHub channel helpers shared by settings UI. The main-process copy lives
+// in packages/desktop/src/main/updater/forkhub.ts; keep the two in sync.
+
+export const FORKHUB_REPO = ".forkhub" as const
+
+const FORKHUB_OWNER_PATTERN = /^[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?$/
+
+export function normalizeForkHubOwner(raw: unknown): string | null {
+  if (typeof raw !== "string") return null
+  const owner = raw.trim()
+  if (owner.length < 1 || owner.length > 39) return null
+  if (!FORKHUB_OWNER_PATTERN.test(owner)) return null
+  return owner
+}
+
+export function forkHubReleasesApiUrl(owner: string): string {
+  return `https://api.github.com/repos/${encodeURIComponent(owner)}/${encodeURIComponent(FORKHUB_REPO)}/releases?per_page=5`
+}
+
+export function forkHubRepoWebUrl(owner: string): string {
+  return `https://github.com/${owner}/${FORKHUB_REPO}/releases`
+}
+
+export type ForkHubOwnerCheck = {
+  owner: string
+  latestTag: string | null
+}
+
+export async function checkForkHubOwner(rawOwner: string, fetchImpl: typeof fetch = fetch): Promise<ForkHubOwnerCheck> {
+  const owner = normalizeForkHubOwner(rawOwner)
+  if (!owner) throw new Error(`"${rawOwner.trim()}" is not a valid GitHub profile or org name.`)
+  const response = await fetchImpl(forkHubReleasesApiUrl(owner), {
+    headers: { Accept: "application/vnd.github+json" },
+  })
+  if (response.status === 404) throw new Error(`${owner} has no .forkhub releases yet.`)
+  if (response.status === 403) throw new Error(`GitHub rate-limited the check for ${owner}/.forkhub.`)
+  if (!response.ok) throw new Error(`Could not check ${owner}/.forkhub (HTTP ${response.status}).`)
+  const rows = (await response.json()) as unknown
+  const releases = Array.isArray(rows) ? rows.filter(isUsableRelease) : []
+  if (releases.length === 0) throw new Error(`${owner}/.forkhub exists but has no published releases yet.`)
+  const latestTag = typeof releases[0].tag_name === "string" ? releases[0].tag_name : null
+  return { owner, latestTag }
+}
+
+function isUsableRelease(row: unknown): row is { tag_name: string; draft?: unknown } {
+  if (typeof row !== "object" || row === null) return false
+  const candidate = row as { tag_name?: unknown; draft?: unknown }
+  return candidate.draft !== true && typeof candidate.tag_name === "string"
+}
