+import { describe, expect, test } from "bun:test"
+import { FORKHUB_REPO, normalizeForkHubOwner, resolveForkHubFeedConfig } from "./forkhub"
+
+describe("normalizeForkHubOwner", () => {
+  test("accepts valid profile and org names", () => {
+    expect(normalizeForkHubOwner("ImBIOS")).toBe("ImBIOS")
+    expect(normalizeForkHubOwner("  octocat  ")).toBe("octocat")
+  })
+
+  test("rejects invalid names", () => {
+    expect(normalizeForkHubOwner("")).toBeNull()
+    expect(normalizeForkHubOwner("not a name!")).toBeNull()
+    expect(normalizeForkHubOwner("-leading")).toBeNull()
+    expect(normalizeForkHubOwner("x".repeat(40))).toBeNull()
+    expect(normalizeForkHubOwner(42)).toBeNull()
+  })
+})
+
+describe("resolveForkHubFeedConfig", () => {
+  test("resolves github feed for a valid owner", () => {
+    expect(resolveForkHubFeedConfig({ owner: "ImBIOS" })).toEqual({
+      provider: "github",
+      owner: "ImBIOS",
+      repo: FORKHUB_REPO,
+    })
+  })
+
+  test("returns null without a valid owner", () => {
+    expect(resolveForkHubFeedConfig({ owner: "not a name!" })).toBeNull()
+  })
+})
diff --git a/packages/desktop/src/main/updater/forkhub.ts b/packages/desktop/src/main/updater/forkhub.ts
new file mode 100644
index 0000000000..1297e0f234
--- /dev/null
+++ b/packages/desktop/src/main/updater/forkhub.ts
@@ -0,0 +1,45 @@
+// ForkHub updater channel: instead of the upstream release feed, a desktop
+// install polls the GitHub Releases of another profile/org's public
+// `.forkhub` catalog repo. The app-side mirror lives in
+// packages/app/src/shell/updates/forkhub.ts; keep the two in sync.
+
+export const FORKHUB_REPO = ".forkhub" as const
+export type ForkHubRepo = typeof FORKHUB_REPO
+
+export type UpdateTrack = "latest" | "forkhub"
+
+export type UpdateTrackInfo = {
+  readonly track: UpdateTrack
+  readonly forkhubOwner: string | null
+  readonly forkhubRepo: ForkHubRepo
+}
+
+const FORKHUB_OWNER_PATTERN = /^[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?$/
+
+export function normalizeForkHubOwner(raw: unknown): string | null {
+  if (typeof raw !== "string") return null
+  const owner = raw.trim()
+  if (owner.length < 1 || owner.length > 39) return null
+  if (!FORKHUB_OWNER_PATTERN.test(owner)) return null
+  return owner
+}
+
+export function resolveForkHubFeedConfig(input: { owner: string; repo?: ForkHubRepo }): {
+  provider: "github"
+  owner: string
+  repo: string
+} | null {
+  const owner = normalizeForkHubOwner(input.owner)
+  if (!owner) return null
+  const repo = input.repo ?? FORKHUB_REPO
+  if (repo !== FORKHUB_REPO) return null
+  return { provider: "github", owner, repo }
+}
+
+export function forkHubReleasesApiUrl(owner: string): string {
+  return `https://api.github.com/repos/${encodeURIComponent(owner)}/${encodeURIComponent(FORKHUB_REPO)}/releases?per_page=5`
+}
+
+export function forkHubRepoWebUrl(owner: string): string {
+  return `https://github.com/${owner}/${FORKHUB_REPO}/releases`
+}
