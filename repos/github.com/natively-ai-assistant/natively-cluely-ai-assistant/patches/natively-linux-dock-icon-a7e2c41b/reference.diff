+          const capitalized = path.join(app.getPath('appData'), 'Natively');
+          if (fs.existsSync(capitalized)) userDataDir = capitalized;
+        }
+      } catch { /* fall back to the historical location */ }
+      app.setPath('userData', userDataDir);
+    } catch (err) { console.warn('[Init] Linux userData pin failed (non-fatal):', err); }
