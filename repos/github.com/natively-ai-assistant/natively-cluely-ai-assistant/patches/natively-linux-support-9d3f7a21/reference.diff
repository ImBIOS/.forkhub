@@ -0,0 +1,60 @@
+// electron/services/__tests__/LinuxDockAssociation.test.mjs
+//
+// Source assertions for the Linux dock/pin fix (third ForkHub patch).
+// GNOME matches windows to .desktop files by WM_CLASS, which Electron
+// derives from the app name: package.json `name` ("natively") vs the
+// shipped StartupWMClass ("Natively") never matched, so the dock showed a
+// generic icon with no pin option. Follows the repo's TrialIpcRedaction
+// convention: read source text, assert the contract.
+
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const ROOT = path.resolve(__dirname, '..', '..', '..');
+const read = (rel) => fs.readFileSync(path.join(ROOT, rel), 'utf8');
+
+test('main: linux pins userData before renaming, both gated to linux', () => {
+  const src = read('electron/main.ts');
+  const gate = src.indexOf("process.platform === 'linux'");
+  assert.ok(gate !== -1, 'linux gate present');
+  const pin = src.indexOf("app.setPath('userData'", gate);
+  const rename = src.indexOf("app.setName('Natively')", gate);
+  assert.ok(pin !== -1 && rename !== -1, 'pin + rename present');
+  assert.ok(pin < rename, 'userData pinned BEFORE setName (no profile move)');
+  // Existing installs live under lowercase dir; a capitalized profile is
+  // respected, never orphaned.
+  assert.match(src, /'natively'/);
+  assert.match(src, /Natively/);
+  // macOS/Windows sequencing untouched (their dock behavior is load-bearing).
+  assert.match(src, /macOS\/Windows sequencing is untouched/);
+});
+
+test('build config declares the WM_CLASS contract + deb hook', () => {
+  const pkg = JSON.parse(read('package.json'));
+  assert.equal(pkg.build.linux.desktop.entry.StartupWMClass, 'Natively');
+  const hook = pkg.build.deb.afterInstall;
+  assert.ok(hook, 'deb.afterInstall set');
+  const hookPath = path.join(ROOT, hook.replace(/^\.\//, ''));
+  assert.ok(fs.existsSync(hookPath), `hook script exists at ${hook}`);
+  const script = fs.readFileSync(hookPath, 'utf8');
+  assert.match(script, /update-desktop-database/);
+  assert.match(script, /gtk-update-icon-cache/);
+  assert.match(script, /exit 0/);
+  // Every refresh is best-effort: a missing tool must never fail installs.
+  const guarded = (script.match(/\|\| true/g) || []).length;
+  assert.ok(guarded >= 2, 'cache refreshes guarded');
+  // No session-process meddling from postinst (wrong context as root).
+  assert.doesNotMatch(script, /xfce4-panel|killall|pkill|systemctl --user/);
+});
+
+test('disguise renaming still owns stealth modes (normal-mode fix only)', () => {
+  const src = read('electron/main.ts');
+  // The early Linux setName covers startup association; per-mode renames
+  // (Terminal/Settings/Activity) still apply later for stealth.
+  assert.match(src, /applyInitialDisguise/);
+  assert.match(src, /_applyDisguise/);
+});
