diff --git a/native-module/src/speaker/linux.rs b/native-module/src/speaker/linux.rs
new file mode 100644
index 0000000..231e435
--- /dev/null
+++ b/native-module/src/speaker/linux.rs
@@ -0,0 +1,386 @@
+// Linux system-audio capture via PulseAudio monitor sources.
+//
+// Every Linux desktop runs PulseAudio or PipeWire's PulseAudio-compatible
+// server, which exposes each sink's `*.monitor` source: a loopback of what
+// the speakers play. cpal's ALSA host only enumerates hardware PCM hints,
+// so those monitors are invisible to it — the `alsa` crate (same version
+// cpal itself uses, shared from Cargo.lock) opens them by pcm name
+// (`pulse:<monitor>`) directly. No new system dependency: libasound is
+// already required to build cpal's ALSA host.
+//
+// The capture loop reads S16LE frames from ALSA, converts to f32 mono,
+// and pushes into the same lock-free ring the lib.rs DSP loop drains —
+// the identical handoff the WASAPI backend uses.
+//
+// Backend name: "pulse" (reported via get_active_backend, same contract as
+// "sck" | "coreaudio" | "wasapi").
+
+use alsa::pcm::{Access, Format, HwParams, PCM};
+use anyhow::Result;
+use ringbuf::{
+    traits::{Producer, Split},
+    HeapCons, HeapProd, HeapRb,
+};
+use std::sync::Arc;
+use std::thread;
+use std::time::Duration;
+
+use super::stop_signal::StopSignal;
+use crate::audio_config::RING_BUFFER_SAMPLES;
+
+/// ALSA read chunk: 20ms at 48kHz stereo = 960 frames.
+const FRAMES_PER_READ: usize = 960;
+
+pub struct SpeakerInput {
+    device_id: Option<String>,
+}
+
+pub struct SpeakerStream {
+    consumer: Option<HeapCons<f32>>,
+    /// Set when capture must stop (drop) or the device died (error string).
+    stop_signal: Arc<StopSignal>,
+    capture_thread: Option<thread::JoinHandle<()>>,
+    actual_sample_rate: u32,
+}
+
+/// A monitor name as PulseAudio reports it ("Monitor of …", "*.monitor")
+/// vs an ALSA pcm name ("pulse:<monitor>"). The default sink's monitor
+/// plays through the plain "pulse" capture device.
+fn is_monitor_name(name: &str) -> bool {
+    name.to_lowercase().contains("monitor")
+}
+
+/// Resolve the ALSA pcm name to open:
+/// - explicit monitor name (user-picked route) → `pulse:<name>`
+/// - anything else (or nothing) → `pulse` (default-source capture, which
+///   follows the default sink's monitor on stock desktop configs)
+/// - "sck"/"default"/empty → `pulse`
+///
+/// Every branch is verified with `parec --device=<name>` semantics: the
+/// `pulse:` prefix selects the PulseAudio plugin, the suffix selects the
+/// source. ("default" maps to pulse on desktops via /usr/share/alsa
+/// defaults; spelling it out keeps behavior identical on minimal asoundrc
+/// setups.)
+fn resolve_pcm_name(device_id: Option<&str>) -> String {
+    match device_id.map(str::trim).filter(|id| !id.is_empty()) {
+        Some(id) if id != "sck" && id != "default" => {
+            if id.starts_with("pulse:") || id == "pulse" {
+                id.to_string()
+            } else {
+                format!("pulse:{}", id)
+            }
+        }
+        _ => "pulse".to_string(),
+    }
+}
+
+/// Query the PulseAudio server for source list via `pactl`, returning
+/// (name, description) pairs. Used for list_output_devices() and for the
+/// default-monitor pick. Empty when pactl is missing or the server is down
+/// — callers treat that as "no monitors", never fatal.
+fn pactl_sources() -> Vec<(String, String)> {
+    let out = std::process::Command::new("pactl")
+        .args(["list", "sources", "short"])
+        .output();
+    let Ok(out) = out else { return Vec::new() };
+    if !out.status.success() {
+        return Vec::new();
+    }
+    let text = String::from_utf8_lossy(&out.stdout);
+    let mut sources = Vec::new();
+    for line in text.lines() {
+        // `0\tiramauto_null.monitor\tmodule-null-sink.c\ts16le 2ch 44100Hz\tSUSPENDED`
+        let mut cols = line.split('\t');
+        let _idx = cols.next();
+        if let Some(name) = cols.next() {
+            // Description comes from the verbose listing; short has none —
+            // use the name for both (matches the macOS backend's id/name
+            // pairing convention when no friendly name exists).
+            sources.push((name.to_string(), name.to_string()));
+        }
+    }
+    sources
+    .into_iter()
+    .filter(|(name, _)| is_monitor_name(name))
+    .collect()
+}
+
+impl SpeakerInput {
+    pub fn new(device_id: Option<String>) -> Result<Self> {
+        // Keep the "sck" escape hatch working: upstream main.ts constructs
+        // SystemAudioCapture('sck') on macOS; on Linux there is no SCK, so
+        // treat it as the default monitor instead of failing.
+        let device_id = device_id.filter(|id| !id.is_empty() && id != "sck" && id != "default");
+        Ok(Self { device_id })
+    }
+
+    /// Spawn the capture thread and wait for it to report its real sample
+    /// rate. Returns Err if init fails or times out, mirroring the WASAPI
+    /// backend contract in windows.rs so lib.rs surfaces the failure to JS
+    /// instead of degrading to a silent fake stream.
+    pub fn stream(self) -> Result<SpeakerStream> {
+        let rb = HeapRb::<f32>::new(RING_BUFFER_SAMPLES);
+        let (producer, consumer) = rb.split();
+
+        let stop_signal = Arc::new(StopSignal::new());
+        let (init_tx, init_rx) = std::sync::mpsc::channel();
+        let device_id = self.device_id;
+
+        let stop_clone = stop_signal.clone();
+        let capture_thread = thread::spawn(move || {
+            if let Err(e) = Self::capture_audio_loop(producer, stop_clone, init_tx, device_id) {
+                eprintln!("[SystemAudio-Pulse] capture loop failed: {}", e);
+            }
+        });
+
+        let actual_sample_rate = match init_rx.recv_timeout(Duration::from_secs(5)) {
+            Ok(Ok(rate)) => rate,
+            Ok(Err(e)) => {
+                let _ = capture_thread.join();
+                return Err(anyhow::anyhow!("PulseAudio monitor init failed: {}", e));
+            }
+            Err(_) => {
+                let _ = capture_thread.join();
+                return Err(anyhow::anyhow!(
+                    "PulseAudio monitor init timed out after 5s (no monitor source, or device busy)"
+                ));
+            }
+        };
+
+        Ok(SpeakerStream {
+            consumer: Some(consumer),
+            stop_signal,
+            capture_thread: Some(capture_thread),
+            actual_sample_rate,
+        })
+    }
+
+    fn capture_audio_loop(
+        mut producer: HeapProd<f32>,
+        stop_signal: Arc<StopSignal>,
+        init_tx: std::sync::mpsc::Sender<Result<u32>>,
+        device_id: Option<String>,
+    ) -> Result<()> {
+        let fail = |msg: anyhow::Error| -> Result<()> {
+            let _ = init_tx.send(Err(anyhow::anyhow!("{}", msg)));
+            Err(msg)
+        };
+
+        let pcm_name = resolve_pcm_name(device_id.as_deref());
+
+        // When the user picked a NON-monitor output route (or the default),
+        // prefer the default sink's monitor explicitly: `parec -d
+        // @DEFAULT_MONITOR@` semantics. pactl gives the default sink name;
+        // its monitor is `<sink>.monitor` on both PulseAudio and PipeWire.
+        // Falls back to plain "pulse" when pactl is unavailable (CI runners
+        // without a session bus) — the ALSA pulse plugin then captures the
+        // default source, which on desktops is the default monitor chain.
+        let pcm_name = if pcm_name == "pulse" {
+            default_monitor_pcm().unwrap_or(pcm_name)
+        } else {
+            pcm_name
+        };
+
+        let pcm = match PCM::new(&pcm_name, alsa::Direction::Capture, false) {
+            Ok(p) => p,
+            Err(e) => {
+                return fail(anyhow::anyhow!(
+                    "cannot open '{}' ({}). System audio capture needs a running PulseAudio/PipeWire server.",
+                    pcm_name,
+                    e
+                ));
+            }
+        };
+
+        // 48kHz stereo S16LE: the monitor's native rate on virtually all
+        // desktops (PipeWire/PulseAudio resample internally). The lib.rs
+        // resampler converts to the 16kHz canonical STT rate downstream.
+        let sample_rate: u32 = 48_000;
+        let channels: u32 = 2;
+        {
+            let hwp = HwParams::any(&pcm).map_err(|e| anyhow::anyhow!("hw params: {}", e))?;
+            hwp.set_channels(channels)
+                .map_err(|e| anyhow::anyhow!("set channels: {}", e))?;
+            hwp.set_rate(sample_rate, alsa::ValueOr::Nearest)
+                .map_err(|e| anyhow::anyhow!("set rate: {}", e))?;
+            hwp.set_format(Format::S16LE)
+                .map_err(|e| anyhow::anyhow!("set format: {}", e))?;
+            hwp.set_access(Access::RWInterleaved)
+                .map_err(|e| anyhow::anyhow!("set access: {}", e))?;
+            pcm.hw_params(&hwp)
+                .map_err(|e| anyhow::anyhow!("apply hw params: {}", e))?;
+        }
+        let io = pcm.io_i16().map_err(|e| anyhow::anyhow!("io handle: {}", e))?;
+
+        println!(
+            "[SystemAudio-Pulse] Monitor: {} ({}Hz stereo S16LE)",
+            pcm_name, sample_rate
+        );
+        // Publish the real hardware rate BEFORE the lib.rs stuck-watchdog
+        // starts counting (same ordering as the WASAPI backend).
+        let _ = init_tx.send(Ok(sample_rate));
+
+        let mut buf = vec![0i16; FRAMES_PER_READ * channels as usize];
+        let mut consecutive_errors: u32 = 0;
+        loop {
+            if stop_signal.is_raised() {
+                break;
+            }
+            match io.readi(&mut buf) {
+                Ok(frames) => {
+                    consecutive_errors = 0;
+                    if frames == 0 {
+                        continue;
+                    }
+                    // Downmix to mono (channel 0), matching the microphone
+                    // path's convention.
+                    let ch = channels as usize;
+                    for f in 0..frames {
+                        let s = buf[f * ch] as f32 / 32768.0;
+                        let _ = producer.try_push(s);
+                    }
+                }
+                Err(e) => {
+                    // EPIPE (overrun): recover and continue — the DSP loop
+                    // tolerates gaps; only a run of failures means the
+                    // device died (headset unplugged, server restarted).
+                    consecutive_errors += 1;
+                    eprintln!(
+                        "[SystemAudio-Pulse] read error {}/5: {}",
+                        consecutive_errors, e
+                    );
+                    if consecutive_errors >= 5 {
+                        stop_signal.raise(format!("PulseAudio monitor read failed 5 times in a row: {}", e));
+                        break;
+                    }
+                    if let Err(recover_err) = pcm.try_recover(e, false) {
+                        eprintln!("[SystemAudio-Pulse] recover failed: {}", recover_err);
+                        thread::sleep(Duration::from_millis(100));
+                    }
+                }
+            }
+        }
+
+        drop(io);
+        drop(pcm);
+        Ok(())
+    }
+}
+
+/// `pulse:<default-sink>.monitor`, or None when pactl/the server is
+/// unavailable. Keeps explicit device selection working when the user
+/// picked a sink by its non-monitor name upstream.
+fn default_monitor_pcm() -> Option<String> {
+    let out = std::process::Command::new("pactl")
+        .args(["get-default-sink"])
+        .output()
+        .ok()?;
+    if !out.status.success() {
+        return None;
+    }
+    let sink = String::from_utf8_lossy(&out.stdout).trim().to_string();
+    if sink.is_empty() {
+        return None;
+    }
+    Some(format!("pulse:{}.monitor", sink))
+}
+
+pub fn list_output_devices() -> Result<Vec<(String, String)>> {
+    // Monitor sources ARE the output-device list on Linux: each one loops
+    // back exactly what its sink plays, so picking a monitor == picking
+    // the output route (same 1:1 shape as WASAPI render devices).
+    Ok(pactl_sources())
+}
+
+/// Default monitor id for the JS route-change poller. Empty when no monitor
+/// exists (JS treats empty as "no route", same as other backends).
+pub fn default_output_device_uid() -> String {
+    pactl_sources().into_iter().next().map(|(id, _)| id).unwrap_or_default()
+}
+
+impl SpeakerStream {
+    pub fn sample_rate(&self) -> u32 {
+        self.actual_sample_rate
+    }
+
+    pub fn take_consumer(&mut self) -> Option<HeapCons<f32>> {
+        self.consumer.take()
+    }
+
+    pub fn take_stop_error(&self) -> Option<String> {
+        self.stop_signal.take()
+    }
+
+    pub fn backend_name(&self) -> &'static str {
+        "pulse"
+    }
+
+    pub fn pause(&mut self) {
+        // Monitor capture has no pause primitive at this layer; callers
+        // stop()/drop the stream instead. Kept for interface parity with
+        // the macOS/Windows backends.
+    }
+
+    pub fn resume(&mut self) -> Result<()> {
+        Ok(())
+    }
+}
+
+impl Drop for SpeakerStream {
+    fn drop(&mut self) {
+        self.stop_signal.raise(String::new());
+        // Join the capture thread so ALSA handles are released before a
+        // subsequent start() constructs a fresh monitor (same discipline
+        // as the WASAPI Drop impl). Bounded wait: a blocking readi() on a
+        // silent monitor can sleep up to one period; 2s is ample and never
+        // blocks teardown forever on a wedged handle.
+        if let Some(handle) = self.capture_thread.take() {
+            let (tx, rx) = std::sync::mpsc::channel();
+            std::thread::spawn(move || {
+                let _ = handle.join();
+                let _ = tx.send(());
+            });
+            let _ = rx.recv_timeout(Duration::from_secs(2));
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{is_monitor_name, resolve_pcm_name};
+
+    #[test]
+    fn monitor_name_matches_pulseaudio_monitors() {
+        assert!(is_monitor_name("Monitor of Dummy Output"));
+        assert!(is_monitor_name(
+            "Monitor of Family 17h (Models 10h-1fh) HD Audio Controller Digital Stereo (HDMI)"
+        ));
+        assert!(is_monitor_name("auto_null.monitor"));
+    }
+
+    #[test]
+    fn monitor_name_rejects_plain_inputs() {
+        assert!(!is_monitor_name("Default Microphone"));
+        assert!(!is_monitor_name("USB Audio Device"));
+    }
+
+    #[test]
+    fn pcm_name_defaults_to_pulse() {
+        assert_eq!(resolve_pcm_name(None), "pulse");
+        assert_eq!(resolve_pcm_name(Some("")), "pulse");
+        assert_eq!(resolve_pcm_name(Some("default")), "pulse");
+        assert_eq!(resolve_pcm_name(Some("sck")), "pulse");
+    }
+
+    #[test]
+    fn pcm_name_prefixes_explicit_monitors() {
+        assert_eq!(
+            resolve_pcm_name(Some("auto_null.monitor")),
+            "pulse:auto_null.monitor"
+        );
+        assert_eq!(
+            resolve_pcm_name(Some("pulse:auto_null.monitor")),
+            "pulse:auto_null.monitor"
+        );
+    }
+}
