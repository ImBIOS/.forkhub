+// electron/services/__tests__/LinuxSystemAudio.test.mjs
+//
+// Source assertions for the Linux system-audio (PulseAudio monitor) backend.
+// Upstream's native speaker module was macOS/Windows-only: on Linux
+// `SpeakerInput::new()` always errored ("Unsupported platform"), so the
+// Audio settings probe surfaced a red FATAL banner and the meeting pipeline
+// could never capture system audio. The fork ships a real Linux backend
+// (native-module/src/speaker/linux.rs) that captures the PulseAudio/
+// PipeWire default-sink monitor via ALSA — same ring/DSP/STT contract as
+// the other backends. Follows the repo's TrialIpcRedaction convention: read
+// source text, assert the contract.
+
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const ROOT = path.resolve(__dirname, '..', '..', '..');
+const read = (rel) => fs.readFileSync(path.join(ROOT, rel), 'utf8');
+
+test('linux backend exists and wires into the speaker module', () => {
+  assert.ok(
+    fs.existsSync(path.join(ROOT, 'native-module/src/speaker/linux.rs')),
+    'BUG: native-module/src/speaker/linux.rs missing — the Linux PulseAudio monitor backend was removed.',
+  );
+  const modSrc = read('native-module/src/speaker/mod.rs');
+  assert.match(modSrc, /pub mod linux;/);
+  assert.match(modSrc, /target_os = "linux"/);
+  assert.match(modSrc, /pub use linux::SpeakerInput/);
+  assert.match(modSrc, /pub use linux::SpeakerStream/);
+  assert.match(modSrc, /pub use linux::list_output_devices/);
+  assert.match(modSrc, /pub use linux::default_output_device_uid/);
+});
+
+test('linux backend reports the pulse backend name', () => {
+  const src = read('native-module/src/speaker/linux.rs');
+  assert.match(src, /"pulse"/);
+  assert.match(src, /pub fn backend_name/);
+});
+
+test('linux backend opens the PipeWire/PulseAudio monitor, not a mic', () => {
+  const src = read('native-module/src/speaker/linux.rs');
+  // Monitor selection: pactl enumeration + `pulse:<monitor>` ALSA opens.
+  assert.match(src, /pactl/);
+  assert.match(src, /monitor/);
+  assert.match(src, /pulse:/);
+  // Loopback capture runs S16LE stereo at the desktop-native rate; the
+  // shared lib.rs resampler converts to the 16kHz STT rate downstream.
+  assert.match(src, /48000|48_000/);
+  assert.match(src, /S16LE/);
+});
+
+test('linux backend honors the shared SpeakerStream contract', () => {
+  const src = read('native-module/src/speaker/linux.rs');
+  assert.match(src, /pub fn sample_rate/);
+  assert.match(src, /pub fn take_consumer/);
+  assert.match(src, /pub fn take_stop_error/);
+  assert.match(src, /pub fn pause/);
+  assert.match(src, /pub fn resume/);
+});
+
+test('fallback stub no longer claims linux is unsupported', () => {
+  const modSrc = read('native-module/src/speaker/mod.rs');
+  assert.doesNotMatch(
+    modSrc,
+    /system audio capture is implemented for macOS and Windows only/,
+    'BUG: the fallback stub still rejects Linux — the pulse backend must own #[cfg(target_os = "linux")] so this stub only covers truly unsupported platforms.',
+  );
+});
diff --git a/electron/utils/__tests__/linuxAutostart.test.mjs b/electron/utils/__tests__/linuxAutostart.test.mjs
new file mode 100644
index 0000000..d1d9844
--- /dev/null
+++ b/electron/utils/__tests__/linuxAutostart.test.mjs
@@ -0,0 +1,252 @@
+// Linux open-at-login: the toggle writes and reads the XDG Autostart entry
+// itself, because Electron's set/getLoginItemSettings are no-ops on Linux
+// (browser_linux.cc). Behavioral tests through the compiled helpers with
+// XDG_CONFIG_HOME pointed at a temp dir — never the real ~/.config.
+//
+// Follows the repo's node:test convention (see
+// utils/__tests__/windowsTaskbarPolicy.test.mjs, which reads the same
+// compiled dist/).
+
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { createRequire } from 'node:module';
+import { fileURLToPath } from 'node:url';
+
+const require = createRequire(import.meta.url);
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const repoRoot = path.resolve(__dirname, '..', '..', '..');
+const dist = (p) => path.join(repoRoot, 'dist-electron/electron', p);
+
+const {
+  LINUX_AUTOSTART_FILENAME,
+  linuxAutostartFilePath,
+  buildLinuxAutostartEntry,
+  execArgv0,
+  resolveLaunchPath,
+  setLinuxOpenAtLogin,
+  getLinuxOpenAtLogin,
+} = require(dist('utils/linuxAutostart.js'));
+const { setOpenAtLogin, getOpenAtLogin } = require(dist('utils/windowsTaskbarPolicy.js'));
+
+const EXE = '/home/test/Applications/Natively-Test-x86_64.AppImage';
+
+function tempEnv(extra = {}) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'natively-autostart-'));
+  return { env: { HOME: dir, XDG_CONFIG_HOME: path.join(dir, '.config'), ...extra }, dir };
+}
+
+function withRealEnv(vars, fn) {
+  const saved = {};
+  for (const k of Object.keys(vars)) {
+    saved[k] = process.env[k];
+    if (vars[k] === undefined) delete process.env[k];
+    else process.env[k] = vars[k];
+  }
+  // APPIMAGE must never leak between cases: a stale host APPIMAGE would make
+  // resolveLaunchPath prefer it over the temp HOME (see the FUSE tests).
+  const savedAppImage = process.env.APPIMAGE;
+  delete process.env.APPIMAGE;
+  try {
+    return fn();
+  } finally {
+    for (const k of Object.keys(vars)) {
+      if (saved[k] === undefined) delete process.env[k];
+      else process.env[k] = saved[k];
+    }
+    if (savedAppImage === undefined) delete process.env.APPIMAGE;
+    else process.env.APPIMAGE = savedAppImage;
+  }
+}
+
+// Delete any ambient APPIMAGE for the whole file: the shell that runs the
+// suite may itself be an AppImage child (or export APPIMAGE=), and the
+// compiled helpers default env to process.env.
+delete process.env.APPIMAGE;
+
+// --- entry shape ------------------------------------------------------------
+
+test('enable writes a single stable entry pointing at the executable', () => {
+  const { env } = tempEnv();
+  assert.equal(setLinuxOpenAtLogin(true, EXE, env), true);
+  const file = linuxAutostartFilePath(env);
+  assert.equal(file, path.join(env.XDG_CONFIG_HOME, 'autostart', LINUX_AUTOSTART_FILENAME));
+  assert.ok(fs.existsSync(file), 'entry file exists');
+  const text = fs.readFileSync(file, 'utf8');
+  assert.match(text, /^\[Desktop Entry\]/m);
+  assert.match(text, /^Type=Application$/m);
+  assert.match(text, /^Name=Natively$/m);
+  assert.match(text, new RegExp(`^TryExec=${EXE.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}$`, 'm'));
+  assert.match(text, /^StartupWMClass=Natively$/m);
+  assert.match(text, /^Hidden=false$/m);
+  const execLine = text.split('\n').find((l) => l.startsWith('Exec='));
+  assert.ok(execLine, 'Exec line present');
+  assert.equal(execArgv0(execLine.slice('Exec='.length)), EXE);
+});
+
+test('entry carries no field codes that a session launcher could mis-expand', () => {
+  const entry = buildLinuxAutostartEntry(EXE);
+  const execLine = entry.split('\n').find((l) => l.startsWith('Exec='));
+  assert.ok(execLine && !/%[a-zA-Z]/.test(execLine), `bare executable, no % codes: ${execLine}`);
+});
+
+test('executable paths with spaces round-trip quoted', () => {
+  const spaced = '/home/test/My Apps/Natively Test.AppImage';
+  const { env } = tempEnv();
+  setLinuxOpenAtLogin(true, spaced, env);
+  const text = fs.readFileSync(linuxAutostartFilePath(env), 'utf8');
+  const execLine = text.split('\n').find((l) => l.startsWith('Exec='));
+  assert.ok(execLine.includes('"'), 'spaces are quoted');
+  assert.equal(execArgv0(execLine.slice('Exec='.length)), spaced);
+  assert.equal(getLinuxOpenAtLogin(spaced, env), true);
+});
+
+test('stable filename is independent of disguise renames', () => {
+  assert.equal(LINUX_AUTOSTART_FILENAME, 'natively.desktop');
+});
+
+// --- launch-path resolution (AppImage FUSE mountpoint is dead at login) ---
+
+test('resolveLaunchPath prefers $APPIMAGE when it exists', () => {
+  const fake = '/stable/path/Natively.AppImage';
+  assert.equal(resolveLaunchPath('/tmp/.mount_Dead123/natively', { APPIMAGE: fake }), fake);
+});
+
+test('resolveLaunchPath keeps a directly-executable exe as-is', () => {
+  assert.equal(resolveLaunchPath('/bin/true', {}), '/bin/true');
+});
+
+test('resolveLaunchPath falls back to the raw exe when nothing better exists', () => {
+  assert.equal(resolveLaunchPath('/nonexistent/natively-xyz', {}), '/nonexistent/natively-xyz');
+});
+
+test('enable from a FUSE-mounted run writes the stable AppImage path', () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'natively-app-'));
+  const fakeAppImage = path.join(dir, 'Natively.AppImage');
+  fs.writeFileSync(fakeAppImage, '#!/bin/sh\n');
+  const { env } = tempEnv({ APPIMAGE: fakeAppImage });
+  assert.equal(setLinuxOpenAtLogin(true, '/tmp/.mount_Dead123/natively', env), true);
+  const text = fs.readFileSync(linuxAutostartFilePath(env), 'utf8');
+  const execLine = text.split('\n').find((l) => l.startsWith('Exec='));
+  assert.ok(execLine.includes(fakeAppImage), 'entry must launch the AppImage: ' + execLine);
+  assert.equal(getLinuxOpenAtLogin(fakeAppImage, env), true);
+  // Same-session re-read under the mountpoint exe resolves to the same
+  // stable path (the env carries APPIMAGE), so it reads ON too.
+  assert.equal(getLinuxOpenAtLogin('/tmp/.mount_Dead123/natively', env), true);
+});
+
+test('a FUSE-mountpoint entry from an older write reads OFF (heals on re-toggle)', () => {
+  const { env } = tempEnv();
+  // Old v1.2.0 entry: raw mountpoint bytes, no APPIMAGE at write time.
+  setLinuxOpenAtLogin(true, '/tmp/.mount_Dead123/natively', env);
+  // Writer and reader agree (same mountpoint, same session): ON.
+  assert.equal(getLinuxOpenAtLogin('/tmp/.mount_Dead123/natively', env), true);
+  // Next login: the mountpoint is gone (TryExec fails). The healed entry
+  // points at the stable host path, so the dead one reads OFF.
+  fs.unlinkSync(linuxAutostartFilePath(env));
+  fs.writeFileSync(
+    linuxAutostartFilePath(env),
+    buildLinuxAutostartEntry('/tmp/.mount_Dead123/natively')
+  );
+  delete process.env.APPIMAGE;
+  assert.equal(getLinuxOpenAtLogin('/home/test/Applications/Natively-App.AppImage', env), false);
+});
+
+// --- read semantics ---
+
+test('get reads OFF when no entry exists, ON after enable, OFF after disable', () => {
+  const { env } = tempEnv();
+  assert.equal(getLinuxOpenAtLogin(EXE, env), false);
+  setLinuxOpenAtLogin(true, EXE, env);
+  assert.equal(getLinuxOpenAtLogin(EXE, env), true);
+  setLinuxOpenAtLogin(false, EXE, env);
+  assert.equal(getLinuxOpenAtLogin(EXE, env), false);
+  assert.ok(!fs.existsSync(linuxAutostartFilePath(env)), 'disable removes the file');
+});
+
+test('disabling a missing entry succeeds (no throw)', () => {
+  const { env } = tempEnv();
+  assert.equal(setLinuxOpenAtLogin(false, EXE, env), true);
+  assert.equal(getLinuxOpenAtLogin(EXE, env), false);
+});
+
+test('a stale entry pointing at a moved AppImage reads OFF, re-enable heals it', () => {
+  const { env } = tempEnv();
+  setLinuxOpenAtLogin(true, '/old/path/Natively.AppImage', env);
+  assert.equal(getLinuxOpenAtLogin(EXE, env), false);
+  setLinuxOpenAtLogin(true, EXE, env);
+  assert.equal(getLinuxOpenAtLogin(EXE, env), true);
+});
+
+test('Hidden=true (turned off in Startup Applications UI) reads OFF', () => {
+  const { env } = tempEnv();
+  setLinuxOpenAtLogin(true, EXE, env);
+  const file = linuxAutostartFilePath(env);
+  fs.writeFileSync(file, fs.readFileSync(file, 'utf8').replace(/^Hidden=false$/m, 'Hidden=true'));
+  assert.equal(getLinuxOpenAtLogin(EXE, env), false);
+});
+
+test('an unparseable entry reads OFF, never throws', () => {
+  const { env } = tempEnv();
+  fs.mkdirSync(path.dirname(linuxAutostartFilePath(env)), { recursive: true });
+  fs.writeFileSync(linuxAutostartFilePath(env), 'not a desktop file\n');
+  assert.equal(getLinuxOpenAtLogin(EXE, env), false);
+});
+
+test('falls back to $HOME/.config/autostart when XDG_CONFIG_HOME is unset', () => {
+  const { env, dir } = tempEnv();
+  delete env.XDG_CONFIG_HOME;
+  setLinuxOpenAtLogin(true, EXE, env);
+  const expected = path.join(dir, '.config', 'autostart', LINUX_AUTOSTART_FILENAME);
+  assert.ok(fs.existsSync(expected), `entry under HOME fallback: ${expected}`);
+  assert.equal(getLinuxOpenAtLogin(EXE, env), true);
+});
+
+// --- policy routing (the actual toggle path) --------------------------------
+
+function throwingApi() {
+  return {
+    setLoginItemSettings() { throw new Error('Electron login-item API must not be called on linux'); },
+    getLoginItemSettings() { throw new Error('Electron login-item API must not be called on linux'); },
+  };
+}
+
+test('linux routes through the autostart file, never Electron', () => {
+  const { dir } = tempEnv();
+  withRealEnv({ XDG_CONFIG_HOME: path.join(dir, '.config'), HOME: dir }, () => {
+    const api = throwingApi();
+    assert.equal(getOpenAtLogin(api, 'linux', EXE), false);
+    setOpenAtLogin(api, 'linux', true, EXE);
+    assert.equal(getOpenAtLogin(api, 'linux', EXE), true);
+    setOpenAtLogin(api, 'linux', false, EXE);
+    assert.equal(getOpenAtLogin(api, 'linux', EXE), false);
+  });
+});
+
+test('linux toggle works when XDG_CONFIG_HOME is unset (HOME fallback)', () => {
+  const { dir } = tempEnv();
+  withRealEnv({ XDG_CONFIG_HOME: undefined, HOME: dir }, () => {
+    const api = throwingApi();
+    setOpenAtLogin(api, 'linux', true, EXE);
+    assert.equal(getOpenAtLogin(api, 'linux', EXE), true);
+    assert.ok(fs.existsSync(path.join(dir, '.config', 'autostart', LINUX_AUTOSTART_FILENAME)));
+    setOpenAtLogin(api, 'linux', false, EXE);
+  });
+});
+
+test('darwin still uses exactly the Electron call (no file, no behavior change)', () => {
+  const { dir } = tempEnv();
+  withRealEnv({ XDG_CONFIG_HOME: path.join(dir, '.config'), HOME: dir }, () => {
+    const calls = [];
+    const api = {
+      setLoginItemSettings(s) { calls.push(s); },
+      getLoginItemSettings() { return { openAtLogin: 'MAC_VALUE' }; },
+    };
+    setOpenAtLogin(api, 'darwin', true, EXE);
+    assert.deepEqual(calls, [{ openAtLogin: true, openAsHidden: false, path: EXE }]);
+    assert.equal(getOpenAtLogin(api, 'darwin', EXE), 'MAC_VALUE');
+    assert.ok(!fs.existsSync(path.join(dir, '.config')), 'no autostart dir touched on darwin');
+  });
+});
diff --git a/electron/utils/linuxAutostart.ts b/electron/utils/linuxAutostart.ts
new file mode 100644
index 0000000..1b63682
--- /dev/null
+++ b/electron/utils/linuxAutostart.ts
@@ -0,0 +1,207 @@
+// Linux open-at-login: the app's own XDG Autostart entry.
+//
+// Electron's setLoginItemSettings/getLoginItemSettings are no-ops on Linux
+// (shell/browser/browser_linux.cc: SetLoginItemSettings is an empty function,
+// GetLoginItemSettings returns defaults). The Settings toggle therefore used
+// to write nothing and always read back OFF on Linux. This module manages the
+// entry directly: `~/.config/autostart/natively.desktop` (honoring
+// $XDG_CONFIG_HOME), which every XDG-compliant session (GNOME, KDE, XFCE,
+// MATE, …) launches at login.
+//
+// Contract:
+// - One stable filename (`natively.desktop`, matching the deb-installed
+//   basename), independent of disguise renames — app.setName() never affects
+//   it. A stale entry pointing at a moved/renamed AppImage reads as OFF so a
+//   re-toggle heals it.
+// - `StartupWMClass=Natively` matches the build.linux.desktop contract and
+//   the early main.ts `app.setName('Natively')`, so the autostarted window
+//   groups with the dock icon instead of opening a second tile.
+// - `TryExec` carries the bare executable path so the session skips the
+//   entry (instead of erroring) when the binary is gone.
+// - Disable deletes the file. A `Hidden=true` entry (e.g. the user turned it
+//   off in GNOME Startup Applications) reads as OFF.
+// - Never throws for a missing file/dir (ENOENT → OFF / no-op remove).
+// - The autostart Exec must be a path the session can launch WITHOUT any
+//   FUSE mount alive: `app.getPath('exe')` inside an AppImage returns the
+//   FUSE mountpoint (`/tmp/.mount_*/natively`), which is gone by next login,
+//   so enabling from a mounted AppImage run writes a dead entry whose
+//   TryExec fails at login. `resolveLaunchPath()` below prefers a stable,
+//   directly-executable path and only falls back to the raw exe when no
+//   better candidate exists. Session managers skip unlaunchable entries
+//   silently, and a failed TryExec at login reads back as OFF (fail-closed),
+//   so the toggle repairs itself on next enable.
+//
+// Pure module: node builtins only, no electron import. `env` (default
+// process.env) is injectable so tests stay hermetic via XDG_CONFIG_HOME.
+
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+
+/** Stable autostart filename (matches the deb-installed basename). */
+export const LINUX_AUTOSTART_FILENAME = 'natively.desktop';
+
+/** WM_CLASS the autostarted window must present (dock grouping contract). */
+export const LINUX_AUTOSTART_WM_CLASS = 'Natively';
+
+export interface LinuxAutostartEnv {
+  HOME?: string;
+  XDG_CONFIG_HOME?: string;
+  APPIMAGE?: string;
+}
+
+function homeDir(env: LinuxAutostartEnv): string {
+  if (env.HOME) return env.HOME;
+  return os.homedir();
+}
+
+export function linuxAutostartDir(env: LinuxAutostartEnv = process.env): string {
+  const base = env.XDG_CONFIG_HOME || path.join(homeDir(env), '.config');
+  return path.join(base, 'autostart');
+}
+
+export function linuxAutostartFilePath(env: LinuxAutostartEnv = process.env): string {
+  return path.join(linuxAutostartDir(env), LINUX_AUTOSTART_FILENAME);
+}
+
+function quoteExec(exePath: string): string {
+  return `"${exePath.replace(/"/g, '\\"')}"`;
+}
+
+/** First shell word of an Exec line (handles the double-quoted form we write). */
+export function execArgv0(execValue: string): string {
+  const trimmed = execValue.trim();
+  if (trimmed.startsWith('"')) {
+    let out = '';
+    for (let i = 1; i < trimmed.length; i++) {
+      const ch = trimmed[i];
+      if (ch === '\\' && i + 1 < trimmed.length) {
+        out += trimmed[i + 1];
+        i++;
+        continue;
+      }
+      if (ch === '"') break;
+      out += ch;
+    }
+    return out;
+  }
+  const space = trimmed.search(/\s/);
+  return space === -1 ? trimmed : trimmed.slice(0, space);
+}
+
+export function buildLinuxAutostartEntry(exePath: string): string {
+  return [
+    '[Desktop Entry]',
+    'Type=Application',
+    'Version=1.0',
+    'Name=Natively',
+    'Comment=Natively will open automatically when you log in to your computer',
+    `Exec=${quoteExec(exePath)}`,
+    `TryExec=${exePath}`,
+    'Terminal=false',
+    `StartupWMClass=${LINUX_AUTOSTART_WM_CLASS}`,
+    'X-GNOME-Autostart-enabled=true',
+    'Hidden=false',
+    'Categories=Office;',
+    '',
+  ].join('\n');
+}
+
+function parseDesktopEntry(text: string): Map<string, string> {
+  const out = new Map<string, string>();
+  let inEntry = false;
+  for (const rawLine of text.split('\n')) {
+    const line = rawLine.trim();
+    if (line.startsWith('[')) {
+      inEntry = line === '[Desktop Entry]';
+      continue;
+    }
+    if (!inEntry || line === '' || line.startsWith('#')) continue;
+    const eq = line.indexOf('=');
+    if (eq === -1) continue;
+    out.set(line.slice(0, eq).trim(), line.slice(eq + 1).trim());
+  }
+  return out;
+}
+
+/**
+ * Enable/disable open-at-login. Returns true when the on-disk state matches
+ * the request (disable of a missing file counts as success). Unexpected IO
+ * errors propagate to the IPC layer, which logs and reports them.
+ */
+export function setLinuxOpenAtLogin(
+  openAtLogin: boolean,
+  exePath: string,
+  env: LinuxAutostartEnv = process.env,
+): boolean {
+  const file = linuxAutostartFilePath(env);
+  if (!openAtLogin) {
+    try {
+      fs.unlinkSync(file);
+    } catch (err: any) {
+      if (err?.code !== 'ENOENT') throw err;
+    }
+    return true;
+  }
+  fs.mkdirSync(path.dirname(file), { recursive: true });
+  fs.writeFileSync(file, buildLinuxAutostartEntry(resolveLaunchPath(exePath, env)));
+  return true;
+}
+
+/**
+ * Resolve the path the autostart entry should launch.
+ * Inside a FUSE-mounted AppImage, app.getPath(exe) returns a transient
+ * mountpoint path that is gone by next login, so prefer the APPIMAGE env
+ * host path when present, else the raw exe when directly executable,
+ * else the raw exe unchanged.
+ */
+export function resolveLaunchPath(
+  exePath: string,
+  env: LinuxAutostartEnv = process.env,
+): string {
+  const appImage = env.APPIMAGE;
+  if (appImage) return appImage;
+  try {
+    fs.accessSync(exePath, fs.constants.X_OK);
+    return exePath;
+  } catch {
+    return exePath;
+  }
+}
+
+/**
+ * True when our autostart entry exists, is not hidden, and points at this
+ * executable. Anything else (missing, unparseable, Hidden=true, stale Exec
+ * from a moved AppImage, or a FUSE-mountpoint entry from an older AppImage
+ * run) is OFF — fail-closed so the toggle never lies ON.
+ *
+ * The stored Exec must equal the RESOLVED current launch path for ON.
+ * Resolution is symmetric with set(): without it, enabling from an AppImage
+ * run would write the stable host path yet read back OFF (stored host path
+ * !== mountpoint exe). A stale entry (AppImage moved, deb-vs-AppImage
+ * switch, dead mountpoint from an older write) resolves differently and
+ * reads OFF, prompting a healing re-toggle.
+ */
+export function getLinuxOpenAtLogin(
+  exePath: string,
+  env: LinuxAutostartEnv = process.env,
+): boolean {
+  const expected = resolveLaunchPath(exePath, env);
+  let text: string;
+  try {
+    text = fs.readFileSync(linuxAutostartFilePath(env), 'utf8');
+  } catch (err: any) {
+    if (err?.code === 'ENOENT') return false;
+    throw err;
+  }
+  let fields: Map<string, string>;
+  try {
+    fields = parseDesktopEntry(text);
+  } catch {
+    return false;
+  }
+  if ((fields.get('Hidden') ?? 'false').toLowerCase() === 'true') return false;
+  const exec = fields.get('Exec');
+  if (!exec) return false;
+  return execArgv0(exec) === expected;
+}
