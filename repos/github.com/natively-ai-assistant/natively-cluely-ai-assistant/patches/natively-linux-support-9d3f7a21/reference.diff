@@ -0,0 +1,58 @@
+// electron/services/__tests__/ForkPatchLinuxSources.test.mjs
+//
+// Source assertions for the ImBIOS Linux fork-build patch (Linux dock +
+// system audio + open-at-login, dynamic per-publisher credit). Companion to
+// ForkPatch2Sources.test.mjs (channel side, in with-fh). Follows the repo's
+// TrialIpcRedaction convention: read source text, assert the
+// contract - no Electron runtime needed.
+
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+// electron/services/__tests__ -> repo root
+const ROOT = path.resolve(__dirname, '..', '..', '..');
+const read = (rel) => fs.readFileSync(path.join(ROOT, rel), 'utf8');
+
+test('linux dock: userData pinned before rename, StartupWMClass contract', () => {
+  const src = read('electron/main.ts');
+  assert.match(src, /LINUX-ONLY dock\/pin/);
+  assert.match(src, /process\.platform === 'linux'/);
+  assert.match(src, /setPath\('userData'/);
+  assert.match(src, /setName\('Natively'\)/);
+  const pkg = JSON.parse(read('package.json'));
+  assert.equal(pkg?.build?.linux?.desktop?.entry?.StartupWMClass, 'Natively');
+});
+
+test('linux open-at-login: XDG entry managed in taskbar policy + IPC reports', () => {
+  const policy = read('electron/utils/windowsTaskbarPolicy.ts');
+  assert.match(policy, /linuxAutostart/);
+  assert.match(policy, /getLinuxOpenAtLogin/);
+  assert.match(policy, /setLinuxOpenAtLogin/);
+  const autostart = read('electron/utils/linuxAutostart.ts');
+  assert.match(autostart, /natively\.desktop/);
+  const ipc = read('electron/ipcHandlers.ts');
+  assert.match(ipc, /XDG Autostart/);
+});
+
+test('linux system audio: pulse backend owns linux, stub narrowed', () => {
+  const modSrc = read('native-module/src/speaker/mod.rs');
+  assert.match(modSrc, /target_os = "linux"/);
+  const toml = read('native-module/Cargo.toml');
+  assert.match(toml, /alsa/);
+});
+
+test('about: credit follows the update publisher, never hardcoded', () => {
+  const src = read('src/components/AboutSection.tsx');
+  assert.match(src, /sponsorsUrlFor/);
+  assert.match(src, /profileUrlFor/);
+  assert.match(src, /feedOwner/);
+  assert.match(src, /getUpdateFeed/);
+  assert.match(src, /Fork Maintainer/);
+  // No hardcoded maintainer identity: each fork credits itself.
+  assert.doesNotMatch(src, /github\.com\/sponsors\/ImBIOS/);
+  assert.doesNotMatch(src, /Imamuzzaki Abu Salam/);
+});
diff --git a/electron/services/__tests__/LinuxDockAssociation.test.mjs b/electron/services/__tests__/LinuxDockAssociation.test.mjs
